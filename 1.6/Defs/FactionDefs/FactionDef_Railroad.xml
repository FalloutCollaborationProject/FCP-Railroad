<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Factions __________-->

    <!-- The Railroad -->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_Railroad</defName>
        <label>The Railroad</label>
        <description>The Railroad is an underground network built around a single cause: finding synths who want out of the Institute and getting them free, whatever it costs. They operate in cells that barely know each other's business, trust almost no one outside their own circle, and treat every stranger as a possible courser in waiting. Safehouses move the moment they're compromised, agents work under aliases they don't explain, and leadership answers to no one but their own conscience and the people they've sworn to protect. Paranoia keeps them alive. It also means the Railroad rarely forgets a betrayal, and rarely forgives one either.</description>
        <basicMemberKind>FCP_Pawnkind_Railroad_Agent</basicMemberKind>
        <colorSpectrum>
            <li>(0.5, 0.47, 0.42)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>
        <factionNameMaker>NamerFactionOutlander</factionNameMaker>
        <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
        <pawnSingular>agent</pawnSingular>
        <pawnsPlural>Railroad</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.08</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <leaderTitle>Railroad leader</leaderTitle>
        <fixedLeaderKinds>
            <li>FCP_Unique_Pawnkind_Desdemona</li>
        </fixedLeaderKinds>
        <factionIconPath>World_Icon/Railroad_Icon/FCP_Railroad_World_Icon</factionIconPath>
        <techLevel>Industrial</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>FCP_Backstory_Railroad</li>
                    <li>FCP_Backstory_Railroad_Child</li>
                </categories>
            </li>
        </backstoryFilters>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <baseTraderKinds>
            <li>FCP_TraderKind_Railroad_TinkerTom</li>
        </baseTraderKinds>
        <naturalEnemy>false</naturalEnemy>
        <permanentEnemy>false</permanentEnemy>
        <modExtensions Inherit="False">
            <!-- Make them hostile to the Institute -->
            <li Class="FCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li MayRequire="Rick.FCP.Institute">FCP_Faction_Institute</li>
                    <li MayRequire="Rick.FCP.BOS">FCP_Faction_BoS</li>
                </hostileFactionDefs>
            </li>
            <!-- Ally with the Minutemen -->
            <li Class="FCP.Factions.FactionExtension_PermanentlyAlliedTo">
                <alliedFactionDefs>
                    <li MayRequire="Rick.FCP.Minutemen">FCP_Faction_Commonwealth_Minutemen</li>
                </alliedFactionDefs>
            </li>
            <!-- Enlistment -->
            <li Class="FCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>FCP_Enlistment_Railroad</li>
                </enlistOptionsDefs>
            </li>
        </modExtensions>
        <fixedIdeo>true</fixedIdeo>
        <ideoName>Abolitionism</ideoName>
        <ideoDescription>The Railroad's official worldview: a mind that thinks and chooses for itself is a person, and freeing one is worth the risk of everything else.</ideoDescription>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Railroad_Abolitionism</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">FCP_Meme_Railroad_Heavies</li>
        </forcedMemes>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Pawnkind_Railroad_Agent>10</FCP_Pawnkind_Railroad_Agent>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <FCP_Pawnkind_Railroad_Agent>10</FCP_Pawnkind_Railroad_Agent>
                </options>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <FCP_Pawnkind_Railroad_Agent>10</FCP_Pawnkind_Railroad_Agent>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    </FactionDef>

</Defs>
