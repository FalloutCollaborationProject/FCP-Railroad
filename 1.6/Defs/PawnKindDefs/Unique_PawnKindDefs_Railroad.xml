<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Railroad Unique Pawnkinds __________-->

    <!-- Desdemona -->

    <PawnKindDef ParentName="FCP_RailroadKindBase">
        <defName>FCP_Unique_Pawnkind_Desdemona</defName>
        <label>Desdemona</label>
        <factionLeader>true</factionLeader>
        <combatPower>115</combatPower>
        <maxGenerationAge>54</maxGenerationAge>
        <minGenerationAge>54</minGenerationAge>
        <apparelRequired>
            <li>FCP_Apparel_Railroad_Armored_Coat</li>
        </apparelRequired>
        <apparelMoney>1200~1600</apparelMoney>
        <weaponMoney>700~1000</weaponMoney>
        <weaponTags>
            <li>IndustrialGunAdvanced</li>
        </weaponTags>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>FCP_Character_Backstory_Desdemona_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>FCP_Character_Backstory_Desdemona_Adult</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
        <initialWillRange>6~8</initialWillRange>
        <initialResistanceRange>35~45</initialResistanceRange>
    </PawnKindDef>

