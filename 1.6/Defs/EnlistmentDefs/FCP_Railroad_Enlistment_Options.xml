<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Enlistment with the Railroad __________-->

    <FCP.Enlist.FactionEnlistOptionsDef>
        <defName>FCP_Enlistment_Railroad</defName>
        <label>The Railroad</label>
        <currencyDef>Silver</currencyDef>
        <minGoodwillRequrementToEnlist>10</minGoodwillRequrementToEnlist>
        <enlistGoodwillGain>5</enlistGoodwillGain>
        <minGoodwillUponEnlist>75</minGoodwillUponEnlist>

        <!-- Enlistment Options -->

        <enlistLetterTitleKey>FCP_Railroad_Enlist_Letter_Title</enlistLetterTitleKey>
        <enlistLetterLabelKey>FCP_Railroad_Enlist_Letter_Label</enlistLetterLabelKey>
        <enlistButtonLabelKey>FCP_Railroad_Enlist_Button_Label</enlistButtonLabelKey>
        <enlistButtonDescKey>FCP_Railroad_Enlist_Button_Desc</enlistButtonDescKey>
        <enlistRequrementsNotSatisfiedKey>FCP_Railroad_Enlist_Requrements_Not_Satisfied</enlistRequrementsNotSatisfiedKey>
        <enlistedToHostileFactionKey>FCP_Railroad_Enlisted_To_Hostile_Faction</enlistedToHostileFactionKey>
        <enlistButtonIconTexPath>UI/Abilities/Invisibility</enlistButtonIconTexPath>
        <enlistedSoundDef>FCP_Sound_Card_Use</enlistedSoundDef>
        <enlistedWithKey>FCP_Railroad_Enlisted_With_Key</enlistedWithKey>

        <!-- Mission Options -->

        <missionsAreEnabled>true</missionsAreEnabled>
        <missionsLabelKey>FCP_Railroad_Missions_Label</missionsLabelKey>
        <missionsDescKey>FCP_Railroad_Missions_Desc</missionsDescKey>
        <missionsButtonIconTexPath>UI/Abilities/CombatCommand</missionsButtonIconTexPath>
        <missionsBackgroundMenuTexPath>UI/Abilities/CombatCommand</missionsBackgroundMenuTexPath>
        <missionsMenuDescriptionKey>FCP_Railroad_Menu_Missions_Desc</missionsMenuDescriptionKey>
        <missionsMenuSelectQuestKey>FCP_Railroad_Menu_Missions_Select_Quest</missionsMenuSelectQuestKey>
        <missionsMenuStartQuestKey>FCP_Railroad_Menu_Missions_Start_Quest</missionsMenuStartQuestKey>
        <missionsBountyRewardRange>30~80</missionsBountyRewardRange>
        <missionsMenuCollectBountyKey>FCP_Railroad_Menu_Missions_Collect_Bounty</missionsMenuCollectBountyKey>

        <!-- Salary Options -->

        <salaryIsEnabled>true</salaryIsEnabled>
        <salaryDef>Silver</salaryDef>
        <salaryLabelKey>FCP_Railroad_Salary_Label</salaryLabelKey>
        <salaryDescKey>FCP_Railroad_Salary_Desc</salaryDescKey>
        <salaryRange>500~900</salaryRange>
        <salaryPeriodDays>10</salaryPeriodDays>

        <!-- Storage Options -->

        <storageIsEnabled>true</storageIsEnabled>
        <storageLabelKey>FCP_Railroad_Storage_Label</storageLabelKey>
        <storageDescKey>FCP_Railroad_Storage_Desc</storageDescKey>
        <storageButtonIconTexPath>UI/Icons/ThingCategories/ResourcesRaw</storageButtonIconTexPath>

        <!-- Work Options -->

        <recreationGainPerTick>0.0001</recreationGainPerTick>
        <workOptions>
            <li>
                <workLabelKey>FCP_Railroad_LineRunning_Label</workLabelKey>
                <workDescKey>FCP_Railroad_LineRunning_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistSocial</workButtonIconTexPath>
                <additionalRestFall>0.25</additionalRestFall>
                <experienceGainsPerHour>
                    <Social>400</Social>
                    <Intellectual>100</Intellectual>
                </experienceGainsPerHour>
            </li>
            <li>
                <workLabelKey>FCP_Railroad_FieldOps_Label</workLabelKey>
                <workDescKey>FCP_Railroad_FieldOps_Desc</workDescKey>
                <workButtonIconTexPath>UI/Roles/SpecialistShooting</workButtonIconTexPath>
                <additionalRestFall>0.3</additionalRestFall>
                <experienceGainsPerHour>
                    <Shooting>500</Shooting>
                    <Melee>100</Melee>
                </experienceGainsPerHour>
            </li>
            <li>
                <workLabelKey>FCP_Railroad_Medic_Label</workLabelKey>
                <workDescKey>FCP_Railroad_Medic_Desc</workDescKey>
                <workButtonIconTexPath>UI/Icons/ThingCategories/Medicine</workButtonIconTexPath>
                <additionalRestFall>0.25</additionalRestFall>
                <tendCaravanMembersEveryTicks>600</tendCaravanMembersEveryTicks>
                <medicinesToTend>
                    <li>MedicineIndustrial</li>
                </medicinesToTend>
                <immunityGainSpeedMultiplier>1.5</immunityGainSpeedMultiplier>
            </li>
        </workOptions>

        <turnInIsEnabled>false</turnInIsEnabled>

        <!-- Drop Pod Options -->

        <dropPodServiceIsEnabled>false</dropPodServiceIsEnabled>

        <!-- Resign Options -->

        <resignGoodwillGain>-25</resignGoodwillGain>
        <resignMenuTextKey>FCP_Railroad_Resign_Menu_Text</resignMenuTextKey>
        <resignLetterTitleKey>FCP_Railroad_Resign_Letter_Title</resignLetterTitleKey>
        <resignLetterLabelKey>FCP_Railroad_Resign_Letter_Label</resignLetterLabelKey>
        <resignButtonLabelKey>FCP_Railroad_Resign_Button_Label</resignButtonLabelKey>
        <resignButtonDescKey>FCP_Railroad_Resign_Button_Desc</resignButtonDescKey>
        <resignButtonIconTexPath>UI/Issues/Apostasy</resignButtonIconTexPath>

        <!-- Kicked Out Options -->

        <kickOutLetterTitleKey>FCP_Railroad_Kick_Out_Letter_Title</kickOutLetterTitleKey>
        <kickOutLetterLabelKey>FCP_Railroad_Kick_Out_Label_Title</kickOutLetterLabelKey>

        <!-- Reinforcements Options -->

        <reinforcementsAreEnabled>true</reinforcementsAreEnabled>
        <reinforcementsButtonLabelKey>FCP_Railroad_Reinforcements_Button_Label</reinforcementsButtonLabelKey>
        <reinforcementsButtonDescKey>FCP_Railroad_Reinforcements_Button_Desc</reinforcementsButtonDescKey>
        <reinforcementsButtonIconTexPath>UI/Commands/WarTrumpet</reinforcementsButtonIconTexPath>
        <reinforcementCallGoodwillCost>-5</reinforcementCallGoodwillCost>
        <reinforcementCallCooldownTicks>50000</reinforcementCallCooldownTicks>
        <reinforcementOptions>
            <li>
                <relationsRange>75~100</relationsRange>
                <pointsRange>700~1600</pointsRange>
            </li>
            <li>
                <relationsRange>50~74</relationsRange>
                <pointsRange>500~750</pointsRange>
            </li>
            <li>
                <relationsRange>26~49</relationsRange>
                <pointsRange>300~500</pointsRange>
            </li>
            <li>
                <relationsRange>-100~25</relationsRange>
                <pointsRange>100~200</pointsRange>
            </li>
        </reinforcementOptions>

    </FCP.Enlist.FactionEnlistOptionsDef>

</Defs>
