    <!-- P.A.M. -->

    <FCP.Core.CharacterDef MayRequire="Rick.FCP.Robotics">
        <defName>FCP_Character_Railroad_PAM</defName>
        <label>P.A.M.</label>
        <description>The Railroad's Predictive Analytical Machine, a pre-war statistical modeling program salvaged and rehoused in a decommissioned assaultron chassis. It calculates probabilities for every operation it's fed, delivering cold percentages on missions that get agents killed either way. Whether it actually cares about the outcomes it predicts is a question nobody in the Railroad has gotten a straight answer to, and P.A.M. isn't in the habit of volunteering one.</description>
        <pawnKind>FCP_Pawnkind_Assaultron</pawnKind>
        <definitions>
            <li Class="FCP.Core.CharacterRobotNameDefinition">
                <name>P.A.M.</name>
            </li>
        </definitions>
    </FCP.Core.CharacterDef>

